#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	# Always run the daemon; if disabled in UCI, it will blank the screen and deep-sleep.
	procd_open_instance
	procd_set_param command /usr/sbin/mipiscreen-ui
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mipiscreen"
}

reload_service() {
	# Touch reload flag for smooth configuration reload without daemon restart
	touch /tmp/mipiscreen.reload 2>/dev/null
}
